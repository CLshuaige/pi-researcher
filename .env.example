# Optional environment variables; export them before starting Pi.
BLSC_API_KEY=
# Optional academic-source credentials; leave unset to use public access.
# S2_API_KEY=
# NCBI_API_KEY=
# OPENALEX_API_KEY=
# CROSSREF_MAILTO=
# OPENALEX_MAILTO=
# UNPAYWALL_EMAIL=
# Optional: override the default workspace-specific .pi/agent directory.
# PI_CODING_AGENT_DIR=/absolute/path/to/private-agent-directory

# Development ports for the shared dev machine.
#   API_PORT      port the API server listens on
#   VITE_DEV_PORT port the Vite dev server listens on
#   VITE_DEV_API  where the dev server proxies /api (usually your API_PORT)
# API_PORT=3001
# VITE_DEV_PORT=5173
# VITE_DEV_API=http://127.0.0.1:3001
