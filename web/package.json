{
  "name": "@gewu/research-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared server tests scripts *.ts *.json index.html"
  },
  "dependencies": {
    "@animate-ui/react": "2.4.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@uiw/react-codemirror": "^4.25.12",
    "@uiw/react-md-editor": "^4.1.6",
    "@xyflow/react": "^12.10.0",
    "archiver": "^7.0.1",
    "copy-to-clipboard": "^4.0.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "motion": "14.9.0",
    "multer": "^2.0.2",
    "radix-ui": "1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "4.5.0",
    "streamdown": "^2.0.0",
    "undici": "^8.10.2",
    "use-stick-to-bottom": "^1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0"
  }
}
